{
  "name": "mission-control-app-factory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "collect:dry-run": "node scripts/collect-openclaw.mjs --dry-run",
    "collect": "node scripts/collect-openclaw.mjs",
    "app-factory": "node scripts/app-factory-job.mjs",
    "app-factory:static": "node scripts/app-factory-static-build.mjs",
    "app-factory:test": "node --test scripts/app-factory-*.test.mjs",
    "supabase:link": "bash scripts/supabase-link.sh",
    "supabase:push": "bash scripts/supabase-push.sh",
    "dev:mission-control": "pnpm --filter mission-control dev",
    "lint": "pnpm --recursive lint",
    "typecheck": "pnpm --recursive typecheck",
    "factory:clean": "node scripts/app-factory-job.mjs clean-stale-commands --older-than-hours 24",
    "factory:commands": "node scripts/app-factory-job.mjs process-commands",
    "factory:healthcheck": "node scripts/app-factory-healthcheck.mjs"
  },
  "pnpm": {
    "overrides": {
      "postcss": "^8.5.10"
    }
  },
  "packageManager": "pnpm@10.0.0"
}
