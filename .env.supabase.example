# Supabase CLI/project linking
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_DB_PASSWORD=your-database-password

# Server-only key used by Mission Control and the local collector.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Browser-safe public values used by the public status demo.
SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_STATUS_APP_SLUG=status-demo

# GitHub — used by app-factory-github.mjs to create private repos under JarvisBot-knox
GITHUB_TOKEN=your-github-token

# Vercel — used by app-factory-vercel.mjs to create projects and trigger deployments
VERCEL_TOKEN=your-vercel-token
VERCEL_TEAM_ID=your-team-id  # optional, leave blank for personal accounts

